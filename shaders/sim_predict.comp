#version 450
#extension GL_GOOGLE_include_directive : require
// Per agent: explosions, desired velocity from the shared flow field + density-dependent speed,
// gravity / climbing, prediction of the new position, and the counting-sort histogram.
#include "common.glsl"
#include "zombie_parts.glsl"
#include "char_common.glsl"
#define TTZ_GORE_SPAWN
#include "gore.glsl"
layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer NavDir  { vec2 navDir[]; };
layout(std430, set = 0, binding = 1) readonly buffer Density { vec4 density[]; };
layout(std430, set = 0, binding = 2) readonly buffer StaticH { float staticH[]; };
layout(std430, set = 0, binding = 3) readonly buffer NavDist { float navDist[]; };   // roaming: attractor awareness
// (bound last: unused here, so the used read-only bindings stay contiguous for the MSL / reflection remap)
layout(std430, set = 0, binding = 4) readonly buffer CorpseH { int corpseH[]; };
layout(std430, set = 1, binding = 0) buffer Agents    { Agent agents[]; };
layout(std430, set = 1, binding = 1) buffer CellCount { uint cellCount[]; };
layout(std430, set = 1, binding = 2) buffer CellLocal { uvec2 cellLocal[]; };
layout(std430, set = 1, binding = 3) buffer Counters  { uint counters[]; };
layout(std430, set = 1, binding = 4) buffer Particles { Particle particles[]; };
layout(std430, set = 1, binding = 5) buffer Gibs      { Gib gibs[]; };
layout(std430, set = 1, binding = 6) buffer GoreCnt   { uint gore[]; };
// gameplay coupling (GAME_HITS): bullet damage queued by game_hits (uint x4 per agent: damage 1/65536,
// flags | hit count << 4, shooter, packed direction), kill ring (header + 8 uints per record)
layout(std430, set = 1, binding = 7) buffer GameIO { uint gameIO[]; };   // kill ring, then hit damage (GAME_HIT_BASE)
#include "gore_write.glsl"
#include "fields.glsl"

vec2 dirAt(ivec2 c) {
    c = clamp(c, ivec2(0), ivec2(int(grid.x) - 1, int(grid.y) - 1));
    return navDir[cellIndex(c)];
}
vec2 sampleDir(vec2 xz) {
    vec2 g = (xz - world.xy) * world.w - 0.5;
    ivec2 c0 = ivec2(floor(g));
    vec2 f = g - vec2(c0);
    vec2 d = mix(mix(dirAt(c0), dirAt(c0 + ivec2(1, 0)), f.x), mix(dirAt(c0 + ivec2(0, 1)), dirAt(c0 + ivec2(1, 1)), f.x), f.y);
    float l = length(d);
    return l > 1e-3 ? d / l : vec2(0.0);
}
float sampleDensity(vec2 xz) { return density[cellIndex(cellCoord(xz))].x; }

// ---- ambient roaming (roamP.x > 0, city): zombies that are not aware of an attractor wander ---------------------
float vnoise1(float x, uint seed) {   // smooth 1D value noise in [0, 1)
    float i = floor(x), f = x - i;
    float a = hash01(uint(int(i)) * 1597334677u ^ seed), b = hash01(uint(int(i) + 1) * 1597334677u ^ seed);
    return mix(a, b, f * f * (3.0 - 2.0 * f));
}
// Slowly drifting divergence-free field (curl of a sum of plane waves): nearby zombies drift the same way (loose
// groups), and being divergence-free it has no sinks, so it never gathers the population into clumps.
vec2 curlField(vec2 xz, float t) {
    const vec2 D[4] = vec2[4](vec2(0.8, 0.6), vec2(-0.447, 0.894), vec2(0.970, -0.243), vec2(-0.707, -0.707));
    const float S[4] = float[4](1.0, 1.37, 0.71, 1.83);
    float k = 6.2831853 / max(roamQ.w, 1.0);
    vec2 v = vec2(0.0);
    for (int j = 0; j < 4; ++j) {
        float th = dot(D[j], xz) * k / S[j] + t * (0.021 + 0.007 * float(j)) + float(j) * 1.7;
        v += cos(th) * vec2(D[j].y, -D[j].x);
    }
    return v * 0.5;
}
bool freeAt(vec2 q, float y) {
    ivec2 c = ivec2(floor((q - world.xy) * world.w));
    if (c.x < 1 || c.y < 1 || c.x >= int(grid.x) - 1 || c.y >= int(grid.y) - 1) return false;   // window border: turn back
    return staticH[cellIndex(c)] <= y + moveP.w;
}
vec2 rot2(vec2 d, float a) { float c = cos(a), s = sin(a); return vec2(c * d.x - s * d.y, s * d.x + c * d.y); }
// first free direction near `dir` (walls deflect wanderers along streets / sidewalks); per-agent side preference
vec2 steerFree(vec2 p, float y, vec2 dir, float side) {
    const float A[8] = float[8](0.0, 0.55, -0.55, 1.1, -1.1, 1.75, -1.75, 3.14159265);
    for (int k = 0; k < 8; ++k) {
        vec2 d = rot2(dir, A[k] * side);
        if (freeAt(p + d * 0.9, y) && freeAt(p + d * 2.1, y)) return d;
    }
    return vec2(0.0);
}
float densAt(ivec2 c) {
    c = clamp(c, ivec2(0), ivec2(int(grid.x) - 1, int(grid.y) - 1));
    return density[cellIndex(c)].x;
}
// Down the crowd-density gradient at a few scales (0.75 .. 5 m): wanderers keep a metre or two apart, and a crowd left
// behind by a faded attractor thins out from its edges instead of standing as a block.
vec2 separation(vec2 xz) {
    ivec2 c = cellCoord(xz);
    vec2 g = vec2(0.0);
    const int K[4] = int[4](1, 2, 4, 7);
    const float W[4] = float[4](1.0, 0.5, 0.45, 0.4);
    for (int j = 0; j < 4; ++j) {
        int k = K[j];
        g.x += (densAt(c + ivec2(k, 0)) - densAt(c - ivec2(k, 0))) * W[j];
        g.y += (densAt(c + ivec2(0, k)) - densAt(c - ivec2(0, k))) * W[j];
    }
    vec2 s = -g * roamQ.x * 0.25;
    float l = length(s);
    return l > 0.6 ? s * (0.6 / l) : s;
}
vec2 roamVelocity(vec3 p, float vary, uint seed, uint kind) {
    float t = timeP.y;
    float y = p.y;
    float side = vary < 0.5 ? 1.0 : -1.0;
    float ws = roamP.y * (0.6 + 0.8 * vary);                                      // staggering: slow and slower ones
    float g = vnoise1(t / 9.0 + vary * 37.0, seed ^ 0x5bd1e995u);                // pauses come and go
    float th = 12.566 * vnoise1(t / 23.0 + vary * 11.0, seed);                     // own heading drifts slowly
    vec2 ind = vec2(cos(th), sin(th));
    vec2 sep = separation(p.xz);
    if (kind == 1u) {   // lurker: goes to the nearest wall / door within a few metres and stands facing it
        vec2 best = vec2(0.0);
        float bestR = 1e9;
        for (int j = 0; j < 8; ++j) {
            vec2 d = rot2(vec2(1.0, 0.0), float(j) * 0.785398 + vary * 0.3);
            for (int r = 1; r <= 6; ++r) {
                float rr = float(r) * 0.75;
                if (rr >= bestR) break;
                if (!freeAt(p.xz + d * rr, y)) { bestR = rr; best = d; break; }
            }
        }
        if (bestR < 1e8 && g > 0.12) return bestR > 1.1 ? best * ws * 0.6 + sep : best * 0.03;
        return ind * 0.03 + sep * 0.5;   // in the open: stands and slowly looks around
    }
    float pauseFrac = kind == 2u ? 0.7 : roamP.z;
    if (g < pauseFrac) return ind * 0.06 + sep;   // paused: shuffles on the spot, turning now and then
    vec2 cf = curlField(p.xz, t);
    float cl = length(cf);
    vec2 dir = ind + (cl > 1e-3 ? cf / max(cl, 1.0) : vec2(0.0)) * 0.9;
    float dl = length(dir);
    dir = dl > 1e-3 ? dir / dl : ind;
    dir = steerFree(p.xz, y, dir, side);
    float sp = ws * (0.65 + 0.7 * vnoise1(t / 4.0 + vary * 53.0, seed ^ 0x27d4eb2fu));
    if (kind == 2u) sp *= 0.35;
    float gait = smoothstep(pauseFrac, min(pauseFrac + 0.08, 1.0), g);           // eases out of / into pauses
    return dir * sp * gait + ind * 0.06 * (1.0 - gait) + sep;
}

// segments that come off together: an arm takes its forearm, a leg its shin
uint severWithChildren(uint s) { return (s == 2u || s == 4u || s == 6u || s == 8u) ? (3u << s) : (1u << s); }

// Blow segments off: one rigid body part per segment, starting at its joint in the zombie's rest pose,
// thrown with the body's new velocity plus a random kick; a blood burst at every joint.
void blowOff(uint mask, vec3 p, vec3 v, float yaw, float f, uint lx, uint ly, uint blood, inout uint rng) {
    float scale = goreQ.y;
    vec4 qy = qaxis(vec3(0.0, 1.0, 0.0), yaw);
    for (uint s = 0u; s < 10u; ++s) {
        if ((mask & (1u << s)) == 0u) continue;
        vec3 joint = p + qrot(qy, ZP_PIVOT[s] * scale);
        if ((s == 3u || s == 5u) && slotModule(lx, ly, s) == ZP_FOREARM_MISSING) continue;   // nothing there
        vec3 kick = randDir(rng);
        kick.y = abs(kick.y) + 0.4;
        vec3 gv = v * (0.6 + 0.5 * rand01(rng)) + kick * (2.0 + 4.0 * f);
        spawnGib(joint, gv, qy, randDir(rng) * (5.0 + 12.0 * f), lx, ly, s, s == 2u || s == 4u, 3u);
        spawnBlood(joint, gv * 0.4, 2.0, 3.0 + 3.0 * f, rng);
    }
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= counters[C_LIVE]) return;
    Agent a = agents[i];
    uint st = agentState(a);
    uint rng = pcgHash(a.info.y ^ (uint(timeP.z) * 2654435761u));  // per-step stream; info.y stays a stable seed
    float dt = timeP.x;

    if (st == ST_DEAD) {
        cellLocal[i] = uvec2(grid.z, atomicAdd(cellCount[grid.z], 1u));  // graveyard bucket
        return;
    }

    vec3 p = a.pos.xyz;
    vec3 v = a.vel.xyz;
    float timer = a.dirs.w;
    float health = agentHealth(a.info.z);
    uint sev = agentSevered(a.info.z), blood = agentBlood(a.info.z);
    vec2 tumble = (st == ST_FALL || st == ST_DYING) ? a.dirs.xy : vec2(0.0);   // roll angle, roll rate
    float vary = agentVary(a);  // stable per-agent [0,1)
    uint lx = agentLookX(a), ly = a.info.y;
    const uint st0 = st;
    const bool game = (gameFlags() & GAME_HITS) != 0u;
    uint shooter = 0u;
    bool shot = false;

    // ---- bullet hits (game mode): the same health / blood / sever / DYING path as blasts, with small parameters --
    if (game) {
        uvec4 h = uvec4(gameIO[GAME_HIT_BASE + 4u * i], gameIO[GAME_HIT_BASE + 4u * i + 1u], gameIO[GAME_HIT_BASE + 4u * i + 2u], gameIO[GAME_HIT_BASE + 4u * i + 3u]);
        if (h.y != 0u) {
            gameIO[GAME_HIT_BASE + 4u * i] = 0u; gameIO[GAME_HIT_BASE + 4u * i + 1u] = 0u; gameIO[GAME_HIT_BASE + 4u * i + 2u] = 0u; gameIO[GAME_HIT_BASE + 4u * i + 3u] = 0u;
            if (st < ST_DYING) {
                shot = true;
                shooter = h.z;
                float dmg = float(h.x) * (1.0 / 65536.0);
                float nHits = float(max(h.y >> 4, 1u));
                bool head = (h.y & 1u) != 0u, quiet = (h.y & 2u) != 0u;
                vec3 dir = unpackSnorm4x8(h.w).xyz;
                dir = length(dir) > 1e-3 ? normalize(dir) : vec3(0.0, 0.0, 1.0);
                health -= dmg;
                v.xz += dir.xz * min(0.35 * nHits * (0.5 + dmg / nHits), 2.0);   // small push along the rounds
                if (health <= 0.0) { st = ST_DYING; timer = 0.0; }
                if (goreP.w > 0.5) {
                    float bh = bodyHeight(a.pos.w);
                    vec3 hp = p + vec3(0.0, head ? bh * 0.92 : bh * 0.62, 0.0);
                    spawnBlood(hp, dir * 1.4 + v * 0.3, 0.9, min((quiet ? 1.5 : 3.0) * nHits, 12.0), rng);   // small puff
                    blood = min(blood + (dmg / nHits > 0.8 ? 2u : 1u), 3u);
                    uint add = 0u;
                    if (head) add |= severWithChildren(0u);   // headshot: the head comes off ("no head: dead")
                    float k = goreP.y * clamp(dmg / nHits - 0.3, 0.0, 1.2) * (1.0 + 0.5 * float(lookBits(ly, 8u, 2u)));
                    const uint CANDH[6] = uint[6](2u, 3u, 4u, 5u, 6u, 8u);
                    const float PROBH[6] = float[6](0.10, 0.22, 0.10, 0.22, 0.08, 0.08);
                    for (int c = 0; c < 6; ++c) {   // heavy rounds take limbs (legless survivors crawl)
                        if (((sev | add) & (1u << CANDH[c])) != 0u) continue;
                        if (rand01(rng) < k * PROBH[c] * min(nHits, 3.0)) add |= severWithChildren(CANDH[c]);
                    }
                    add &= ~sev;
                    if (add != 0u) {
                        if ((add & 3u) != 0u) { health = min(health, 0.0); st = ST_DYING; timer = 0.0; }   // no head: dead
                        blowOff(add, p, v + dir * 1.5, a.dirs.z, 0.25, lx, ly, blood, rng);
                        atomicAdd(gore[G_SEVERED], bitCount(add));
                        sev |= add;
                    }
                } else if (head) { health = min(health, 0.0); st = ST_DYING; timer = 0.0; }
                if (st == ST_DYING) tumble.y += (rand01(rng) - 0.5) * 4.0;
            }
        }
    }

    // ---- explosions (only agents inside a radius do extra work) ------------
    for (uint e = 0u; e < counts.y; ++e) {
        vec3 c = explo[e].xyz;
        float r = explo[e].w;
        vec3 d = (p + vec3(0.0, 0.6, 0.0)) - c;
        float dist = length(d);
        if (dist >= r) continue;
        float f = 1.0 - dist / r;
        vec3 dir = dist > 1e-3 ? d / dist : vec3(0.0, 1.0, 0.0);
        dir.y = abs(dir.y) + exploP[e].z;
        dir = normalize(dir);
        float rnd = rand01(rng);
        v += dir * exploP[e].x * f * (0.55 + 0.9 * rnd);
        if (st < ST_DYING) {
            health -= f * f * exploP[e].y * (0.6 + 0.8 * rand01(rng));
            if (health <= 0.0) { st = ST_DYING; timer = 0.0; }
            else { st = ST_FALL; timer = max(timer, 0.4 + 1.6 * f); }
        }
        // ---- gore: blood, spin, severed limbs (visual; legless survivors crawl) ----
        tumble.y += (rand01(rng) - 0.5) * 2.0 * (3.0 + 9.0 * f);     // the blast sets the body spinning
        if (goreP.w > 0.5) {
            spawnBlood(p + vec3(0.0, 1.1, 0.0), v * 0.3, 1.5 + 2.5 * f, 0.3 + 5.0 * f * f, rng);
            blood = max(blood, f > 0.55 ? 3u : (f > 0.25 ? 2u : 1u));
            uint add = 0u;
            if (st == ST_DYING && f > goreP.z) add = SEVER_ALL;      // close to a lethal blast: torn apart
            else {
                float k = goreP.y * f * f * (1.0 + 0.5 * float(lookBits(ly, 8u, 2u)));   // decomposed parts come off easier
                const uint CAND[7] = uint[7](0u, 2u, 3u, 4u, 5u, 6u, 8u);
                const float PROB[7] = float[7](0.10, 0.22, 0.30, 0.22, 0.30, 0.12, 0.12);
                for (int c = 0; c < 7; ++c) {
                    uint b = severWithChildren(CAND[c]);
                    if (((sev | add) & (1u << CAND[c])) != 0u) continue;
                    if (rand01(rng) < k * PROB[c]) add |= b;
                }
            }
            add &= ~sev;
            if (add != 0u) {
                if ((add & 3u) != 0u) { health = min(health, 0.0); if (st < ST_DYING) { st = ST_DYING; timer = 0.0; } }   // no head: dead
                blowOff(add, p, v, a.dirs.z, f, lx, ly, blood, rng);
                atomicAdd(gore[G_SEVERED], bitCount(add));
                if ((sev | add) == SEVER_ALL) atomicAdd(gore[G_GIBBED], 1u);
                sev |= add;
            }
        }
    }

    // ---- awareness (roaming): an attractor within reach (nav distance under the gate) = pursuit; memory decays ----
    const bool roam = roamP.x > 0.5;
    uint alert = agentAlert(a.info.z);
    bool aware = true;
    if (roam) {
        float nd = navDist[cellIndex(cellCoord(p.xz))];
        aware = nd < 0.5e7 && !(goreQ.z > 0.0 && nd > goreQ.z);
        if (aware) alert = 15u;
        else if (alert > 0u && rand01(rng) < dt * 15.0 / max(roamP.w, 0.1)) alert -= 1u;   // ~roamP.w s from 15 to 0
    }

    // ---- desired velocity -----------------------------------------------------
    vec2 desired;
    if (aware) {   // pursuit: stream along the shared flow field with crowd-density speed (unchanged behaviour)
        vec2 flow = sampleDir(p.xz);
        float wob = sin(timeP.y * (0.5 + vary) + vary * 40.0) * extraP.y;
        float cw = cos(wob), sw = sin(wob);
        flow = vec2(cw * flow.x - sw * flow.y, sw * flow.x + cw * flow.y);
        float rhoAhead = sampleDensity(p.xz + flow * crowdP.w);
        float speedF = clamp(1.0 - (rhoAhead - crowdP.x) / max(crowdP.y - crowdP.x, 1e-3), crowdP.z, 1.0);
        float baseSpeed = agentP.w * (0.7 + 0.6 * vary);
        float speed = mix(baseSpeed * speedF, extraP.w * (0.8 + 0.4 * vary), clamp(a.pos.w, 0.0, 1.0));
        desired = flow * speed;
    } else {       // idle: wander; after losing the attractor keep the last heading, then drift back to wandering
        vec2 wv = roamVelocity(p, vary, a.info.y, agentRoamKind(a.info.y));
        vec2 prevD = (st0 == ST_WALK || st0 == ST_CLIMB) ? a.dirs.xy : vec2(0.0);
        float m = float(alert) / 15.0;
        desired = alert == 0u ? wv : mix(prevD, wv, min(1.0, dt * (0.12 + 1.6 * (1.0 - m) * (1.0 - m))));
    }

    if (st == ST_WALK || st == ST_CLIMB) {
        v.xz += (desired - v.xz) * min(1.0, moveP.x * dt);
    } else {
        desired = vec2(0.0);
        v.xz *= 1.0 - min(1.0, 0.3 * dt);
    }

    if (st == ST_CLIMB) {
        float target = uintBitsToFloat(a.info.w);
        v.y = p.y < target ? moveP.z : min(v.y, 0.0);
    } else {
        v.y -= moveP.y * dt;
    }
    float sp = length(v);
    if (sp > extraP.x) v *= extraP.x / sp;

    a.prev.xyz = p;
    p += v * dt;
    a.pos.xyz = p;
    a.vel.xyz = v;
    a.dirs.xy = (st == ST_FALL || st == ST_DYING) ? tumble : desired;
    a.dirs.w = timer;
    a.info.x = st | agentLookX(a);
    a.info.z = packAgentZ(health, sev, blood) | (alert << 28);
    agents[i] = a;

    // ---- kill record (game mode): exactly one thread sees an agent's alive -> DYING transition ----------------
    if (game && st0 < ST_DYING && st == ST_DYING) {
        uint seq = atomicAdd(gameIO[1], 1u) + 1u;
        uint slot = atomicAdd(gameIO[0], 1u);
        if (slot < GAME_KILL_CAP) {
            uint b = GAME_KILL_HEADER + slot * 8u;
            gameIO[b] = seq;
            gameIO[b + 1u] = shot ? 0u : (counts.y > 0u ? 1u : 2u);   // KillCause: Soldier / Explosion / Other
            gameIO[b + 2u] = shot ? shooter : 0u;
            gameIO[b + 3u] = 0u;
            gameIO[b + 4u] = floatBitsToUint(p.x);
            gameIO[b + 5u] = floatBitsToUint(p.y);
            gameIO[b + 6u] = floatBitsToUint(p.z);
            gameIO[b + 7u] = 0u;
        } else {
            atomicAdd(gameIO[2], 1u);   // overflow: counted, rewarded anonymously by the game
        }
    }

    uint cell = cellIndex(cellCoord(p.xz));
    cellLocal[i] = uvec2(cell, atomicAdd(cellCount[cell], 1u));
}
