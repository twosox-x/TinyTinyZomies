#version 450
#extension GL_GOOGLE_include_directive : require
// Selective corpse reactivation: corpses inside an explosion radius leave the height field
// and re-enter the agent simulation as DYING bodies (they get thrown by the predict pass).
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer StaticH { float staticH[]; };
layout(std430, set = 1, binding = 0) buffer Corpses  { Corpse corpses[]; };
layout(std430, set = 1, binding = 1) buffer Agents   { Agent agents[]; };
layout(std430, set = 1, binding = 2) buffer CorpseH  { int corpseH[]; };
layout(std430, set = 1, binding = 3) buffer Counters { uint counters[]; };
#define TTZ_CORPSE_WRITABLE
#include "fields.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(counters[C_CORPSES], uint(corpseP.w))) return;
    Corpse cp = corpses[i];
    if (cp.info.z < 0.5) return;
    bool hit = false;
    for (uint e = 0u; e < counts.y; ++e) {
        if (distance(cp.pos.xyz, explo[e].xyz) < explo[e].w * 0.7) { hit = true; break; }
    }
    if (!hit) return;
    uint slot = counters[C_LIVE] + atomicAdd(counters[C_APPEND], 1u);
    if (slot >= grid.w) return;     // agent pool full: corpse stays
    cp.info.z = 0.0;
    corpses[i] = cp;
    vec2 fwd = vec2(sin(cp.pos.w), cos(cp.pos.w));
    splatCorpse(cp.pos.xz + fwd * 0.45, -cp.info.w);
    splatCorpse(cp.pos.xz - fwd * 0.45, -cp.info.w);
    atomicAdd(counters[C_REACTIVATED], 1u);
    Agent a;
    a.pos = vec4(cp.pos.xyz + vec3(0.0, 0.15, 0.0), 1.0);
    a.vel = vec4(0.0);
    a.prev = vec4(a.pos.xyz, 0.0);
    a.dirs = vec4(0.0, 0.0, cp.pos.w, 0.0);
    uint seed = pcgHash(i * 31u + 7u);
    a.info = uvec4(ST_DYING | (uint(cp.info.y) << 8), seed, floatBitsToUint(0.0), 0u);
    agents[slot] = a;
}
