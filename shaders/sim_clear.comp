#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 1, binding = 0) buffer CellCount { uint cellCount[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i <= grid.z) cellCount[i] = 0u;   // numCells + 1 (graveyard bucket)
}
