#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Post
{
    float4 p0;
    float4 p1;
};

struct main0_out
{
    float4 outColor [[color(0)]];
};

struct main0_in
{
    float2 vUv [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant Post& _27 [[buffer(0)]], texture2d<float> sharpTex [[texture(0)]], texture2d<float> blurTex [[texture(1)]], sampler sharpTexSmplr [[sampler(0)]], sampler blurTexSmplr [[sampler(1)]])
{
    main0_out out = {};
    float4 s = sharpTex.sample(sharpTexSmplr, in.vUv);
    float3 col = s.xyz;
    if (_27.p0.x > 0.0)
    {
        float4 b = blurTex.sample(blurTexSmplr, in.vUv);
        float grad = smoothstep(_27.p0.z, _27.p0.z + _27.p0.w, abs(in.vUv.y - _27.p0.y));
        float depthC = fast::max(1.0 - s.w, (1.0 - b.w) * 0.60000002384185791015625) * _27.p1.z;
        float coc = fast::clamp(fast::max(grad, depthC) * _27.p0.x, 0.0, 1.0);
        col = mix(col, b.xyz, float3(coc));
    }
    float l = dot(col, float3(0.2989999949932098388671875, 0.58700001239776611328125, 0.114000000059604644775390625));
    col = mix(float3(l), col, float3(_27.p1.x));
    col = ((col - float3(0.5)) * _27.p1.y) + float3(0.5);
    float2 v = in.vUv - float2(0.5);
    col *= (1.0 - ((_27.p1.w * dot(v, v)) * 1.60000002384185791015625));
    out.outColor = float4(fast::clamp(col, float3(0.0), float3(1.0)), 1.0);
    return out;
}

