};

fragment main0_out main0(main0_in in [[stage_in]], constant Blur& _26 [[buffer(0)]], texture2d<float> src [[texture(0)]], sampler srcSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 c = src.sample(srcSmplr, in.vUv) * 0.227026998996734619140625;
    float2 o1 = _26.dir.xy * 1.384615421295166015625;
