#pragma clang diagnostic ignored "-Wmissing-prototypes"
#pragma clang diagnostic ignored "-Wmissing-braces"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T, size_t Num>
struct spvUnsafeArray
{
    T elements[Num ? Num : 1];
    
    thread T& operator [] (size_t pos) thread
    {
        return elements[pos];
    }
    constexpr const thread T& operator [] (size_t pos) const thread
    {
        return elements[pos];
    }
    
    device T& operator [] (size_t pos) device
    {
        return elements[pos];
    }
    constexpr const device T& operator [] (size_t pos) const device
    {
        return elements[pos];
    }
    
    constexpr const constant T& operator [] (size_t pos) const constant
    {
        return elements[pos];
    }
    
    threadgroup T& operator [] (size_t pos) threadgroup
    {
        return elements[pos];
    }
    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
    {
        return elements[pos];
    }
};

struct Frame
{
    float4x4 viewProj;
    float4 camPos;
    float4 sunDir;
    float4 sunColor;
    float4 skyColor;
    float4 groundColor;
    float4 fogColor;
    float4 gridP;
    uint4 gridDim;
    float4 modelP;
    float4 goalsF[4];
    float4 blasts[8];
    float4 lightPos[24];
    float4 lightCol[24];
    float4 blastsP[8];
};

constant spvUnsafeArray<float2, 6> _19 = spvUnsafeArray<float2, 6>({ float2(0.0), float2(1.0), float2(1.0, 0.0), float2(0.0), float2(0.0, 1.0), float2(1.0) });

struct main0_out
{
    float3 vWorld [[user(locn0)]];
    float4 gl_Position [[position]];
};

vertex main0_out main0(constant Frame& _42 [[buffer(0)]], uint gl_VertexIndex [[vertex_id]])
{
    main0_out out = {};
    float2 c = _19[int(gl_VertexIndex)];
    float2 size = float2(_42.gridDim.xy) * _42.gridP.z;
    float2 xz = (_42.gridP.xy - float2(40.0)) + (c * (size + float2(80.0)));
    out.vWorld = float3(xz.x, ((_42.gridDim.w & 64u) != 0u) ? 0.02999999932944774627685546875 : 0.0, xz.y);
    out.gl_Position = _42.viewProj * float4(out.vWorld, 1.0);
    return out;
}

