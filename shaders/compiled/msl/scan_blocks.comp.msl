#pragma clang diagnostic ignored "-Wmissing-prototypes"
#pragma clang diagnostic ignored "-Wmissing-braces"

#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

template<typename T, size_t Num>
struct spvUnsafeArray
{
    T elements[Num ? Num : 1];
    
    thread T& operator [] (size_t pos) thread
    {
        return elements[pos];
    }
    constexpr const thread T& operator [] (size_t pos) const thread
    {
        return elements[pos];
    }
    
    device T& operator [] (size_t pos) device
    {
        return elements[pos];
    }
    constexpr const device T& operator [] (size_t pos) const device
    {
        return elements[pos];
    }
    
    constexpr const constant T& operator [] (size_t pos) const constant
    {
        return elements[pos];
    }
    
    threadgroup T& operator [] (size_t pos) threadgroup
    {
        return elements[pos];
    }
    constexpr const threadgroup T& operator [] (size_t pos) const threadgroup
    {
        return elements[pos];
    }
};

struct SimUniforms
{
    float4 world;
    uint4 grid;
    float4 timeP;
    float4 agentP;
    float4 moveP;
    float4 crowdP;
    float4 solverP;
    float4 climbP;
    float4 corpseP;
    float4 navP;
    float4 goals[4];
    float4 explo[8];
    float4 exploP[8];
    uint4 counts;
    float4 spawnRect;
    uint4 misc;
    float4 extraP;
    float4 lookA;
    float4 lookB;
    uint4 forcedLook;
    float4 goreP;
    uint4 goreCap;
    float4 goreQ;
};

struct BlockSums
{
    uint blockSums[1];
};

constant uint3 gl_WorkGroupSize [[maybe_unused]] = uint3(256u, 1u, 1u);

kernel void main0(constant SimUniforms& _19 [[buffer(0)]], device BlockSums& _65 [[buffer(1)]], uint3 gl_LocalInvocationID [[thread_position_in_threadgroup]])
{
    threadgroup spvUnsafeArray<uint, 256> sh;
    uint nb = _19.misc.y;
    uint li = gl_LocalInvocationID.x;
    uint chunk = (nb + 255u) / 256u;
    uint b0 = li * chunk;
    uint b1 = min((b0 + chunk), nb);
    uint sum = 0u;
    for (uint b = b0; b < b1; b++)
    {
        sum += _65.blockSums[b];
    }
    sh[li] = sum;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    uint _96;
    for (uint off = 1u; off < 256u; off = off << 1u)
    {
        if (li >= off)
        {
            _96 = sh[li - off];
        }
        else
        {
            _96 = 0u;
        }
        uint t = _96;
        threadgroup_barrier(mem_flags::mem_threadgroup);
        sh[li] += t;
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    uint run = sh[li] - sum;
    for (uint b_1 = b0; b_1 < b1; b_1++)
    {
        uint x = _65.blockSums[b_1];
        _65.blockSums[b_1] = run;
        run += x;
    }
}

