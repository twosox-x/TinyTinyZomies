{
    return float4(axis * sin(ang * 0.5), cos(ang * 0.5));
}

static inline __attribute__((always_inline))
float3 qrot(thread const float4& q, thread const float3& v)
{
    float3 t = cross(q.xyz, v) * 2.0;
    return (v + (t * q.w)) + cross(q.xyz, t);
}

