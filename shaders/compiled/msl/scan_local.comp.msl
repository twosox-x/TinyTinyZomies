        _45 = 0u;
    }
    uint v = _45;
    sh[li] = v;
    threadgroup_barrier(mem_flags::mem_threadgroup);
    uint _79;
    for (uint off = 1u; off < 256u; off = off << 1u)
    {
        if (li >= off)
        {
            _79 = sh[li - off];
        }
        else
        {
            _79 = 0u;
        }
        uint t = _79;
        threadgroup_barrier(mem_flags::mem_threadgroup);
        sh[li] += t;
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if (gi < n)
    {
        _105.cellStart[gi] = sh[li] - v;
    }
    if (li == 255u)
