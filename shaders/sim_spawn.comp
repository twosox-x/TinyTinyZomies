#version 450
#extension GL_GOOGLE_include_directive : require
// Appends spawnCount new agents at random positions inside spawnRect.
#include "common.glsl"
#include "zombie_parts.glsl"
#include "zombie_look.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer StaticH { float staticH[]; };
// misc.y = 1: one agent per point (x, z, jitter radius, unused) from spawnPts[misc.x + i] (ambient population)
layout(std430, set = 0, binding = 1) readonly buffer SpawnPts { vec4 spawnPts[]; };
layout(std430, set = 1, binding = 0) buffer Agents { Agent agents[]; };
layout(std430, set = 1, binding = 1) buffer Counters { uint counters[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= counts.z) return;
    uint rng = pcgHash(i * 9781u + counts.w * 6271u + 17u);
    // never spawn inside static geometry: retry a few random positions inside the rect
    vec2 p = vec2(0.0);
    bool found = false;
    if (misc.y == 1u) {
        vec4 sp = spawnPts[misc.x + i];
        for (int t = 0; t < 8 && !found; ++t) {
            float r = t == 0 ? 0.0 : sp.z * float(t) / 4.0, an = rand01(rng) * 6.2831853;
            p = sp.xy + vec2(cos(an), sin(an)) * r;
            found = staticH[cellIndex(cellCoord(p))] <= 0.0;
        }
    } else
    for (int t = 0; t < 32 && !found; ++t) {
        p = vec2(mix(spawnRect.x, spawnRect.z, rand01(rng)), mix(spawnRect.y, spawnRect.w, rand01(rng)));
        found = staticH[cellIndex(cellCoord(p))] <= 0.0;
    }
    if (!found) return;
    uint slot = counters[C_LIVE] + atomicAdd(counters[C_APPEND], 1u);
    if (slot >= grid.w) return;
    Agent a;
    a.pos = vec4(p.x, 0.0, p.y, 0.0);
    a.vel = vec4(0.0, 0.0, 0.0, rand01(rng) * 6.2831);
    a.prev = vec4(a.pos.xyz, 0.0);
    a.dirs = vec4(0.0, 0.0, rand01(rng) * 6.2831, 0.0);
    uvec2 look = generateLook(rng);                  // modular appearance, fixed for the zombie's lifetime
    uint state = ST_WALK;
    float timer = 0.0;
    if (lookB.z > 0.5) { state = ST_DYING; timer = 9.0; a.pos.w = 1.0; }   // bench/test: spawn as a settling corpse
    a.dirs.w = timer;
    if (forcedLook.z == 1u) a.dirs.z = 0.0;          // showcase characters face +Z like Zombie Lab (2: game spawn, random)
    float health = forcedLook.w != 0u ? uintBitsToFloat(forcedLook.w) : 1.0;   // game: risen soldiers are tougher
    a.info = uvec4(state | look.x, look.y, packAgentZ(health, 0u, 0u), floatBitsToUint(0.0));
    agents[slot] = a;
}
