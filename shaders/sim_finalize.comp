#version 450
#extension GL_GOOGLE_include_directive : require
// Per agent (sorted order): derive velocity from the solved position, update pressure/blocked
// estimate, run the WALK / CLIMB / FALL / DYING state machine and convert settled bodies to corpses.
// Writes back into agentsA so that the persistent agent array stays spatially sorted.
#include "common.glsl"
#define TTZ_GORE_SPAWN
#define TTZ_GORE_DECALS
#include "gore.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer AgentsB    { Agent agentsB[]; };
layout(std430, set = 0, binding = 1) readonly buffer PosFinal   { vec4 posFinal[]; };
layout(std430, set = 0, binding = 2) readonly buffer ContactAux { vec4 contactAux[]; };
layout(std430, set = 0, binding = 3) readonly buffer StaticH    { float staticH[]; };
layout(std430, set = 1, binding = 0) buffer AgentsA  { Agent agentsA[]; };
layout(std430, set = 1, binding = 1) buffer Corpses  { Corpse corpses[]; };
layout(std430, set = 1, binding = 2) buffer CorpseH  { int corpseH[]; };
layout(std430, set = 1, binding = 3) buffer Counters { uint counters[]; };
layout(std430, set = 1, binding = 4) buffer Particles { Particle particles[]; };
layout(std430, set = 1, binding = 5) buffer GoreCnt   { uint gore[]; };
layout(std430, set = 1, binding = 6) buffer Decals    { uint decals[]; };
Gib gibs[1];   // spawnGib is not used here
#include "gore_write.glsl"
#define TTZ_CORPSE_WRITABLE
#include "fields.glsl"

float lerpAngle(float a, float b, float t) {
    float d = mod(b - a + 3.14159265, 6.2831853) - 3.14159265;
    return a + d * t;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= counters[C_LIVE]) return;
    Agent a = agentsB[i];
    float dt = timeP.x;
    vec3 x = posFinal[i].xyz;
    vec3 v = (x - a.prev.xyz) / dt;
    uint st = agentState(a);
    // Constraint projections must not become launch velocities ("popcorn" in dense jams):
    // only ballistic bodies (explosions) keep large velocities.
    float vmax = (st == ST_FALL || st == ST_DYING) ? extraP.x : max(agentP.w * 2.0, moveP.z * 1.5);
    float sp = length(v);
    if (sp > vmax) v *= vmax / sp;

    float timer = a.dirs.w;
    float vary = agentVary(a);
    vec4 aux = contactAux[i];
    float ground = groundHeight(x.xz, x.y);
    float elev = x.y - ground;
    bool grounded = elev < 0.05;
    if (grounded && v.y < 0.0) v.y = 0.0;
    bool supported = grounded || aux.y > x.y - 0.25;
    if (supported && v.y < 0.0 && !grounded) v.y *= 0.5;   // contact damping on top of the pile

    // pressure / blocked estimate: how much of the desired motion is not happening
    vec2 desired = (st == ST_WALK || st == ST_CLIMB) ? a.dirs.xy : vec2(0.0);   // FALL / DYING: dirs.xy = tumble
    float dsp2 = dot(desired, desired);
    float progress = dsp2 > 0.0025 ? clamp(dot(v.xz, desired) / dsp2, 0.0, 1.0) : 1.0;
    float blocked = mix(a.prev.w, 1.0 - progress, 1.0 - exp(-dt / 0.6));

    const bool vertical = (misc.w & FLAG_VERTICAL) != 0u && climbP.x > 0.5;
    float climbTarget = uintBitsToFloat(a.info.w);
    float standH = agentP.y;

    // over a drop (roof edge: pushed by the crowd, stepping off): free fall under gravity (not the walk speed clamp)
    if ((st == ST_WALK || st == ST_CLIMB) && !supported && elev > 1.5 && v.y < -1.0) { st = ST_FALL; timer = FALL_EDGE_TIMER; }
    if (st == ST_WALK) {
        // Climb onto the blocking body ahead if we have been pushed long enough.
        // The target is the top of an actual neighbour -> no climbing invisible walls.
        // Requires sustained pressure AND a dense contact neighbourhood (crowd crush), so free-flowing
        // crowds do not climb; thresholds vary per agent so the crowd never climbs in sync.
        float thr = climbP.y * (0.8 + 0.4 * vary);
        if (vertical && blocked > thr && aux.w >= 4.0 && aux.x > x.y + 0.3 && aux.x < x.y + standH * 1.25) {
            st = ST_CLIMB;
            timer = 0.0;
            climbTarget = aux.x + 0.05;
        }
    } else if (st == ST_CLIMB) {
        timer += dt;
        if (!vertical || x.y >= climbTarget - 0.03 || timer > climbP.w || aux.w < 0.5) { st = ST_WALK; timer = 0.0; }
    } else if (st == ST_FALL) {
        timer -= dt;
        if (timer < FALL_EDGE_TIMER + 1.0 && timer > FALL_EDGE_TIMER - 60.0) timer = FALL_EDGE_TIMER;   // keep the edge-fall mark
        if (timer <= 0.0 && supported) { st = ST_WALK; timer = 0.0; }
    } else if (st == ST_DYING) {
        if (timer < -0.5) {   // impact of a roof-edge fall (sim_predict): splat of blood around the body
            timer = 0.0;
            addBloodPool(x.xz, 1.3, 600u);
        }
        timer += dt;
        float spd = length(v);
        bool resting = (grounded || supported) && spd < max(corpseP.z * 3.0, 1.2);
        // angle of repose: bodies do not come to rest on steep corpse slopes, they slide down first
        float hx = corpseBilinear(x.xz + vec2(0.4, 0.0)) - corpseBilinear(x.xz - vec2(0.4, 0.0));
        float hz = corpseBilinear(x.xz + vec2(0.0, 0.4)) - corpseBilinear(x.xz - vec2(0.0, 0.4));
        vec2 grad = vec2(hx, hz) / 0.8;
        float slope = length(grad);
        bool steep = slope > 0.65;
        if (steep && grounded && timer < 8.0) v.xz -= grad / max(slope, 1e-3) * min(slope, 2.0) * 4.0 * dt * 10.0;
        // Settle when at rest on the ground, or when lying still on other bodies / jammed against a wall
        // (those used to keep tumbling for the full timeout); the timeout is the last resort.
        bool settled = (grounded && !steep && spd < corpseP.z && timer > 0.35) || (resting && timer > 1.5) || timer > 4.0;
        uint sevD = agentSevered(a.info.z);
        if (settled && sevD == SEVER_ALL) {            // torn apart: nothing left to lie there, only a blood pool
            st = ST_DEAD;
            atomicAdd(counters[C_DEATHS_TOTAL], 1u);
            addBloodPool(x.xz, 0.7, 120u);
        } else if (settled) {
            st = ST_DEAD;
            atomicAdd(counters[C_DEATHS_TOTAL], 1u);
            if ((misc.w & FLAG_CORPSES) != 0u) {
                float yaw = a.dirs.z;                      // no pop: the body keeps the heading it fell with
                vec2 fwd = vec2(sin(yaw), cos(yaw));
                uint idx = atomicAdd(counters[C_CORPSES], 1u);
                float h = corpseP.y;
                Corpse cp;
                cp.pos = vec4(x.x, ground, x.z, yaw);
                // the corpse keeps the zombie's complete modular appearance, missing parts and blood;
                // pose = a static library entry lying the same way up as the body came to rest
                bool faceUp = (int(round(abs(a.dirs.x) / 3.14159265)) & 1) == 1;   // roll near pi: on the back
                uint k = pcgHash(a.info.y ^ idx * 747796405u) % CORPSE_POSES;
                for (uint j = 0u; j < 8u && ((hash01(k * 8u + 9137u) > 0.5) != faceUp); ++j) k = (k + 1u) % CORPSE_POSES;
                cp.info = uvec4(agentLookX(a), a.info.y,
                                1u | (agentBlood(a.info.z) << 1) | (k << 8) | (sevD << 16), floatBitsToUint(h));
                addBloodPool(x.xz, 0.35 + 0.3 * vary, agentBlood(a.info.z) > 1u ? 90u : 40u);
                if (idx < uint(corpseP.w)) corpses[idx] = cp;
                else atomicAdd(counters[C_CORPSE_OVERFLOW], 1u);   // height still accumulates; instance not stored
                splatCorpse(x.xz + fwd * 0.45, h);
                splatCorpse(x.xz - fwd * 0.45, h);
            }
        }
    }

    // tumble (FALL / DYING): spin set by the blast, braked as soon as the body touches anything;
    // a dying body rolls onto its back or front, never keeps spinning against walls or on the crowd
    vec2 tumble = (st == ST_FALL || st == ST_DYING) ? a.dirs.xy : vec2(0.0);
    if (st == ST_FALL || st == ST_DYING) {
        bool touching = supported || aux.w >= 1.0 || aux.z > 0.5;
        tumble.y *= exp(-dt * (touching ? goreQ.x : 0.3));
        tumble.x += tumble.y * dt;
        if (touching) {
            float rest = round(tumble.x / 3.14159265) * 3.14159265;
            tumble.x += (rest - tumble.x) * (1.0 - exp(-dt * 4.0));
        }
        tumble.x -= 6.2831853 * round(tumble.x / 6.2831853);
    }
    uint sevNow = agentSevered(a.info.z);
    if (sevNow != 0u && st != ST_DEAD) {           // open wounds drip
        uint rng = pcgHash(a.info.y ^ (uint(timeP.z) * 1597334677u));
        if (rand01(rng) < dt * 4.0) spawnParticle(x + vec3(0.0, 0.9, 0.0), v * 0.5 + randDir(rng) * 0.6, 2.0, PT_BLOOD, 0.05);
    }

    // pose: crawl when climbing or riding the crowd, flat when falling/dying; no legs: crawl for good
    float proneTarget = 0.0;
    if (st == ST_CLIMB || (elev > 0.45 && supported)) proneTarget = 1.0;
    if ((sevNow & 0x3C0u) != 0u) proneTarget = 1.0;
    // roaming crawlers lie in the street while calm and get up when they notice something
    if (roamP.x > 0.5 && st == ST_WALK && agentRoamKind(a.info.y) == 2u && agentAlert(a.info.z) < 6u) proneTarget = 1.0;
    if (st == ST_FALL) proneTarget = 0.6;
    if (st == ST_DYING) proneTarget = 1.0;
    float prone = mix(a.pos.w, proneTarget, 1.0 - exp(-dt * extraP.z));

    float hsp = length(v.xz);
    float heading = a.dirs.z;
    if (st == ST_WALK || st == ST_CLIMB) {
        vec2 face = hsp > 0.25 ? v.xz : desired;
        if (dot(face, face) > 1e-4) heading = lerpAngle(heading, atan(face.x, face.y), 1.0 - exp(-dt * 5.0));
    }
    float phase = a.vel.w + dt * (st == ST_CLIMB ? 9.0 : (1.0 + hsp * 4.2));

    if (st == ST_CLIMB) atomicAdd(counters[C_CLIMBING], 1u);
    if (st == ST_FALL || st == ST_DYING) atomicAdd(counters[C_AIRBORNE], 1u);
    if (elev > 0.5 && st != ST_DEAD) atomicAdd(counters[C_ELEVATED], 1u);
    if (st != ST_DEAD) atomicMax(counters[C_MAX_HEIGHT_MM], uint(max(elev, 0.0) * 1000.0));

    a.pos = vec4(x, prone);
    a.vel = vec4(v, mod(phase, 6283.0));
    a.prev.w = blocked;
    a.dirs.z = heading;
    a.dirs.w = timer;
    if (st == ST_FALL || st == ST_DYING) a.dirs.xy = tumble;
    a.info.x = st | agentLookX(a);
    a.info.w = floatBitsToUint(climbTarget);
    agentsA[i] = a;
}
