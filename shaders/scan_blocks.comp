#version 450
#extension GL_GOOGLE_include_directive : require
// Pass 2: single workgroup exclusive scan of block sums (any count; each thread scans a chunk serially).
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 1, binding = 0) buffer BlockSums { uint blockSums[]; };
shared uint sh[256];
void main() {
    uint nb = misc.y;
    uint li = gl_LocalInvocationID.x;
    uint chunk = (nb + 255u) / 256u;
    uint b0 = li * chunk;
    uint b1 = min(b0 + chunk, nb);
    uint sum = 0u;
    for (uint b = b0; b < b1; ++b) sum += blockSums[b];
    sh[li] = sum;
    barrier();
    for (uint off = 1u; off < 256u; off <<= 1u) {
        uint t = li >= off ? sh[li - off] : 0u;
        barrier();
        sh[li] += t;
        barrier();
    }
    uint run = sh[li] - sum;
    for (uint b = b0; b < b1; ++b) { uint x = blockSums[b]; blockSums[b] = run; run += x; }
}
