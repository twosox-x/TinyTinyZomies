#version 450
#extension GL_GOOGLE_include_directive : require
// Counting-sort scatter: agents are physically reordered by cell so neighbour loops read contiguous memory.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer AgentsA   { Agent agentsA[]; };
layout(std430, set = 0, binding = 1) readonly buffer CellLocal { uvec2 cellLocal[]; };
layout(std430, set = 0, binding = 2) readonly buffer CellStart { uint cellStart[]; };
layout(std430, set = 0, binding = 3) readonly buffer Counters  { uint counters[]; };
layout(std430, set = 1, binding = 0) buffer AgentsB { Agent agentsB[]; };
layout(std430, set = 1, binding = 1) buffer PosP    { vec4 posP[]; };
layout(std430, set = 1, binding = 2) buffer PrevS   { vec4 prevS[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= counters[C_LIVE]) return;     // still the pre-sort count here
    uvec2 cl = cellLocal[i];
    if (cl.x >= grid.z) return;            // dead -> dropped
    uint dst = cellStart[cl.x] + cl.y;
    Agent a = agentsA[i];
    agentsB[dst] = a;
    posP[dst] = vec4(a.pos.xyz, bodyHeight(a.pos.w));
    // desired horizontal velocity encoded in w (used for crawl-relative friction)
    prevS[dst] = vec4(a.prev.xyz, encodeDesired(a.dirs.xy));
}
