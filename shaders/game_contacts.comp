#version 450
#extension GL_GOOGLE_include_directive : require
// Zombies pressing on soldiers (HordeBridge::postSim, after game_field). One thread per soldier:
// attackers = live walkers / climbers whose centre is within reach of the capsule surface (5 x 5 cells, exact),
// nearestDist = nearest of those cells (else of the tile samples around), nearby = walkers in the tiles whose centre
// lies within the nearby radius (coarse, from game_field).
// out[4 * s]: attackers, nearby, float bits of nearestDist, packed id.  extraP is reused: x reach, y nearby radius,
// z threat radius of the exact nearest list.
// near[32 * s ...]: the 4 nearest live walkers / climbers within extraP.z (any height: rooftop soldiers see the street),
// exact positions of this step: 4 x (pos.xyz, dist) then 4 x (vel.xz, prone, 0); dist 1e9 = empty. Searched tile ring by
// tile ring (6 m tiles from game_field, empty tiles skipped), stopping once the 4th is closer than the next ring.
// near[32 * s + 32 ...] (stride 40 floats): the live walker / climber nearest to the soldier's target lock point (word 7
// of its GameSolid record: 16-bit x / z offsets from the feet, 1/128 m, 0 = no lock) within LOCK_R: (pos.xyz, dist),
// (vel.xz, prone, 0); dist 1e9 = none. Long-range locks are coarse field samples; this keeps them on the real zombie.
#include "common.glsl"
layout(local_size_x = 64) in;
const float LOCK_R = 2.0;   // == SoldierContact::kLockReach
layout(std430, set = 0, binding = 0) readonly buffer GameSolid { uint gameSolid[]; };   // 8 uints per soldier from word 0
layout(std430, set = 0, binding = 1) readonly buffer Agents    { Agent agents[]; };
layout(std430, set = 0, binding = 2) readonly buffer CellStart { uint cellStart[]; };
layout(std430, set = 0, binding = 3) readonly buffer CellCount { uint cellCount[]; };
layout(std430, set = 0, binding = 4) readonly buffer Counters  { uint counters[]; };
layout(std430, set = 0, binding = 5) readonly buffer Field     { uint field[]; };
layout(std430, set = 1, binding = 0) buffer Contacts { uint contacts[]; };
layout(std430, set = 1, binding = 1) buffer Near { vec4 nearOut[]; };
void main() {
    uint s = gl_GlobalInvocationID.x;
    if (s >= misc.z) return;
    vec4 soP = uintBitsToFloat(uvec4(gameSolid[8u * s], gameSolid[8u * s + 1u], gameSolid[8u * s + 2u], gameSolid[8u * s + 3u]));
    vec4 soI = uintBitsToFloat(uvec4(gameSolid[8u * s + 4u], gameSolid[8u * s + 5u], gameSolid[8u * s + 6u], gameSolid[8u * s + 7u]));
    const float reach = extraP.x, nearR = extraP.y;
    const uint live = counters[C_LIVE];
    vec3 sp = soP.xyz;
    uint attackers = 0u, nearby = 0u;
    float nearest = 1e9;
    vec2 g = (sp.xz - world.xy) * world.w;
    bool inside = all(greaterThanEqual(g, vec2(0.0))) && all(lessThan(g, vec2(grid.xy)));
    if (inside) {
        ivec2 c = ivec2(floor(g));
        for (int dy = -2; dy <= 2; ++dy)
        for (int dx = -2; dx <= 2; ++dx) {
            ivec2 cc = c + ivec2(dx, dy);
            if (cc.x < 0 || cc.y < 0 || cc.x >= int(grid.x) || cc.y >= int(grid.y)) continue;
            uint cid = cellIndex(cc);
            uint b = cellStart[cid], e = min(b + cellCount[cid], live);
            for (uint k = b; k < e && k < b + 64u; ++k) {
                Agent a = agents[k];
                uint st = agentState(a);
                if (st >= ST_DYING) continue;
                if (a.pos.y > sp.y + soI.x + 0.3 || a.pos.y + bodyHeight(a.pos.w) < sp.y - 0.3) continue;
                float dist = distance(a.pos.xz, sp.xz);
                nearest = min(nearest, dist);
                if (st <= ST_CLIMB && dist - soP.w <= reach) ++attackers;
            }
        }
        // nearby: coarse tiles (6 m) whose centre is within the radius
        uint T = counts.z, tx = counts.x, tz = (T + tx - 1u) / max(tx, 1u);
        float tileM = world.z * 8.0;
        ivec2 tc = ivec2(floor((sp.xz - world.xy) / tileM));
        int rr = int(ceil(nearR / tileM));
        for (int dy = -rr; dy <= rr; ++dy)
        for (int dx = -rr; dx <= rr; ++dx) {
            ivec2 t = tc + ivec2(dx, dy);
            if (t.x < 0 || t.y < 0 || t.x >= int(tx) || t.y >= int(tz)) continue;
            vec2 centre = world.xy + (vec2(t) + 0.5) * tileM;
            uint ti = uint(t.y) * tx + uint(t.x);
            uint n = field[ti];
            if (distance(centre, sp.xz) <= nearR) nearby += n;
            if (nearest > 1e8 && n > 0u)
                for (uint q = 0u; q < min(n, 4u); ++q) {
                    uint b = T + ti * 16u + q * 4u;
                    nearest = min(nearest, distance(vec2(uintBitsToFloat(field[b]), uintBitsToFloat(field[b + 2u])), sp.xz));
                }
        }
    }
    // ---- exact nearest walkers for targeting (SoldierAI): rings of 6 m tiles, cells of non-empty tiles only
    vec4 bp[4] = vec4[4](vec4(0.0, 0.0, 0.0, 1e9), vec4(0.0, 0.0, 0.0, 1e9), vec4(0.0, 0.0, 0.0, 1e9), vec4(0.0, 0.0, 0.0, 1e9));
    vec3 bv[4] = vec3[4](vec3(0.0), vec3(0.0), vec3(0.0), vec3(0.0));   // vel.xz, prone factor (crawlers: aim low)
    const float threatR = extraP.z;
    if (inside && threatR > 0.0) {
        uint T = counts.z, tx = counts.x, tz = (T + tx - 1u) / max(tx, 1u);
        float tileM = world.z * 8.0;
        ivec2 tc = ivec2(floor((sp.xz - world.xy) / tileM));
        int rr = int(ceil(threatR / tileM));
        uint scanned = 0u;
        for (int r = 0; r <= rr; ++r) {
            if (r >= 2 && bp[3].w < float(r - 1) * tileM) break;   // nothing in ring r can beat the 4th nearest
            for (int dy = -r; dy <= r; ++dy)
            for (int dx = -r; dx <= r; ++dx) {
                if (max(abs(dx), abs(dy)) != r) continue;
                ivec2 t = tc + ivec2(dx, dy);
                if (t.x < 0 || t.y < 0 || t.x >= int(tx) || t.y >= int(tz)) continue;
                if (field[uint(t.y) * tx + uint(t.x)] == 0u) continue;
                for (int cy = 0; cy < 8; ++cy)
                for (int cx = 0; cx < 8; ++cx) {
                    ivec2 cc = t * 8 + ivec2(cx, cy);
                    if (cc.x >= int(grid.x) || cc.y >= int(grid.y)) continue;
                    uint cid = cellIndex(cc);
                    uint b = cellStart[cid], e = min(b + cellCount[cid], live);
                    for (uint k = b; k < e && k < b + 32u; ++k) {
                        Agent a = agents[k];
                        if (agentState(a) >= ST_DYING) continue;
                        ++scanned;
                        float dist = distance(a.pos.xz, sp.xz);
                        if (dist > threatR || dist >= bp[3].w) continue;
                        int j = 3;
                        while (j > 0 && bp[j - 1].w > dist) { bp[j] = bp[j - 1]; bv[j] = bv[j - 1]; --j; }
                        bp[j] = vec4(a.pos.xyz, dist);
                        bv[j] = vec3(a.vel.xz, a.pos.w);
                    }
                }
            }
            if (scanned > 6000u) break;   // bounded per soldier (dense crowds: the nearest rings are already full)
        }
    }
    // ---- the exact zombie at the target lock point (7 x 7 cells around it)
    vec4 lp = vec4(0.0, 0.0, 0.0, 1e9), lv = vec4(0.0);
    uint lk = gameSolid[8u * s + 7u];
    if (inside && lk != 0u) {
        vec2 q = sp.xz + (vec2(float(lk & 0xFFFFu), float(lk >> 16)) - 32768.0) / 128.0;
        ivec2 c = ivec2(floor((q - world.xy) * world.w));
        for (int dy = -3; dy <= 3; ++dy)
        for (int dx = -3; dx <= 3; ++dx) {
            ivec2 cc = c + ivec2(dx, dy);
            if (cc.x < 0 || cc.y < 0 || cc.x >= int(grid.x) || cc.y >= int(grid.y)) continue;
            uint cid = cellIndex(cc);
            uint b = cellStart[cid], e = min(b + cellCount[cid], live);
            for (uint k = b; k < e && k < b + 32u; ++k) {
                Agent a = agents[k];
                if (agentState(a) >= ST_DYING) continue;
                float dist = distance(a.pos.xz, q);
                if (dist <= LOCK_R && dist < lp.w) { lp = vec4(a.pos.xyz, dist); lv = vec4(a.vel.xz, a.pos.w, 0.0); }
            }
        }
    }
    for (uint q = 0u; q < 4u; ++q) { nearOut[10u * s + q] = bp[q]; nearOut[10u * s + 4u + q] = vec4(bv[q], 0.0); }
    nearOut[10u * s + 8u] = lp;
    nearOut[10u * s + 9u] = lv;
    contacts[4u * s] = attackers;
    contacts[4u * s + 1u] = nearby;
    contacts[4u * s + 2u] = floatBitsToUint(nearest);
    contacts[4u * s + 3u] = floatBitsToUint(soI.z);
}
