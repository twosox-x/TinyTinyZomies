#version 450
#extension GL_GOOGLE_include_directive : require
// 1 thread. Writes indexed-indirect draw args for living zombies and corpses.
#include "common.glsl"
layout(local_size_x = 1) in;
layout(std430, set = 0, binding = 0) readonly buffer Counters { uint counters[]; };
layout(std430, set = 1, binding = 0) buffer Indirect { uint ind[]; };
void main() {
    ind[I_ZOMBIE_DRAW + 0u] = misc.z;
    ind[I_ZOMBIE_DRAW + 1u] = counters[C_LIVE];
    ind[I_ZOMBIE_DRAW + 2u] = 0u;
    ind[I_ZOMBIE_DRAW + 3u] = 0u;
    ind[I_ZOMBIE_DRAW + 4u] = 0u;
    ind[I_CORPSE_DRAW + 0u] = misc.z;
    ind[I_CORPSE_DRAW + 1u] = min(counters[C_CORPSES], uint(corpseP.w));
    ind[I_CORPSE_DRAW + 2u] = 0u;
    ind[I_CORPSE_DRAW + 3u] = 0u;
    ind[I_CORPSE_DRAW + 4u] = 0u;
}
