#version 450
#extension GL_GOOGLE_include_directive : require
// Corpse rot (GAME_DESIGN 14d): one thread per corpse slot. Ages corpses (own buffer keyed by position), emits gas into
// the coarse gas grid once rotting, counts corpses per cell, ignites corpses in flame cones / ground fire, burns them
// and removes burnt ones (alive bit cleared, height un-splatted: the pile shrinks, the gas source is gone).
// The rot level (0..63) is written into the corpse's info.z bits 26..31 (free bits) for renderers.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Counters { uint counters[]; };
layout(std430, set = 0, binding = 1) readonly buffer Field    { uvec4 field[]; };
float staticH[1];   // fields.glsl declares helpers that read it; only splatCorpse (corpseH) is used here
layout(std430, set = 1, binding = 0) buffer Corpses  { Corpse corpses[]; };
layout(std430, set = 1, binding = 1) buffer CorpseH  { int corpseH[]; };
layout(std430, set = 1, binding = 2) buffer Rot      { uvec4 rot[]; };
layout(std430, set = 1, binding = 3) buffer Accum    { uint accum[]; };
layout(std430, set = 1, binding = 4) buffer Out      { uint outW[]; };   // packed cells, then GAS_STAT_WORDS stats
#define TTZ_CORPSE_WRITABLE
#include "fields.glsl"
#include "gas.glsl"
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= min(counters[C_CORPSES], uint(miscP.x))) return;
    Corpse cp = corpses[i];
    if ((cp.info.z & 1u) == 0u) return;
    uint key = floatBitsToUint(cp.pos.x) * 2654435761u ^ floatBitsToUint(cp.pos.z) ^ (cp.info.y * 97u);
    uvec4 r = rot[i];
    float age = uintBitsToFloat(r.y), ign = uintBitsToFloat(r.z), burn = uintBitsToFloat(r.w);
    if (r.x != key) { age = 0.0; ign = 0.0; burn = 0.0; }
    float dt = rotP.x;
    age += dt;
    ivec2 g = gasCoord(cp.pos.xz);
    bool inside = gasInside(g);
    float rotK = (gshift.z & 1u) != 0u ? clamp((age - rotP.y) / max(rotP.z, 1.0), 0.0, 1.0) : 0.0;
    bool rotting = (gshift.z & 1u) != 0u && age > rotP.y;
    if (inside) {
        uint c = gasIndex(g);
        // fire: flame cones on the body (spray seconds) or ground fire in its cell ignite it after fireP.x s
        uint owner;
        float spray = coneCover(cp.pos.xyz + vec3(0.0, 0.3, 0.0), 0.6, owner);
        float ground = uintBitsToFloat(field[c].y);
        if (burn <= 0.0) {
            ign += spray + (ground > 0.0 ? dt : 0.0);
            if (ign >= fireP.x) { burn = 1e-4; atomicAdd(outW[gdim.z + GAS_STAT_IGNITED], 1u); }
        }
        if (burn > 0.0) {
            burn += dt;
            atomicAdd(outW[gdim.z + GAS_STAT_BURNING], 1u);
            atomicMax(accum[4u * c + 3u], uint(min(airP.w, 60.0) * 256.0));   // a burning body keeps its cell on fire
            if (burn >= fireP.y) {   // burnt away: leaves the corpse list and the height field (gas source removed)
                cp.info.z &= ~1u;
                corpses[i] = cp;
                vec2 fwd = vec2(sin(cp.pos.w), cos(cp.pos.w));
                splatCorpse(cp.pos.xz + fwd * 0.45, -uintBitsToFloat(cp.info.w));
                splatCorpse(cp.pos.xz - fwd * 0.45, -uintBitsToFloat(cp.info.w));
                atomicAdd(outW[gdim.z + GAS_STAT_BURNED], 1u);
                rot[i] = uvec4(0u);
                return;
            }
        }
        atomicAdd(accum[4u * c + 1u], 1u);
        atomicAdd(outW[gdim.z + GAS_STAT_CORPSES], 1u);
        if (rotting && burn <= 0.0) {
            atomicAdd(accum[4u * c + 2u], 1u);
            atomicAdd(outW[gdim.z + GAS_STAT_ROTTING], 1u);
            atomicAdd(accum[4u * c], uint(rotK * rotP.w * dt * 65536.0 + 0.5));
        }
    }
    // rot level for renderers (info.z bits 26..31, unused by the corpse layout); burning bodies char (63)
    uint lvl = burn > 0.0 ? 63u : uint(rotK * 62.0 + (rotting ? 1.0 : 0.0));
    uint z = (cp.info.z & 0x03FFFFFFu) | (lvl << 26);
    if (z != cp.info.z) { cp.info.z = z; corpses[i].info.z = z; }
    rot[i] = uvec4(key, floatBitsToUint(age), floatBitsToUint(ign), floatBitsToUint(burn));
}
