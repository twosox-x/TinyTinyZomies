#version 450
#extension GL_GOOGLE_include_directive : require
// Pass 1: frustum-cull zombies (mode 0) or corpses (mode 1), append visible characters and count
// their segments per size class. Exact compaction: the local index per segment is kept for pass 3.
#include "common.glsl"
#include "zombie_parts.glsl"
#include "char_common.glsl"
#include "char_uniforms.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer Agents    { Agent agents[]; };
layout(std430, set = 0, binding = 1) readonly buffer Corpses   { Corpse corpses[]; };
layout(std430, set = 0, binding = 2) readonly buffer SimCount  { uint simCounters[]; };
layout(std430, set = 0, binding = 3) readonly buffer MeshInfo  { uvec4 meshInfo[]; };
layout(std430, set = 0, binding = 4) readonly buffer Occluders { vec4 occluders[]; };   // building boxes: min, max

// segment p0 -> p1 against an axis-aligned box (slab test)
bool segmentHitsBox(vec3 p0, vec3 p1, vec3 bmin, vec3 bmax) {
    vec3 d = p1 - p0;
    vec3 inv = 1.0 / mix(d, vec3(1e-9), lessThan(abs(d), vec3(1e-9)));
    vec3 t0 = (bmin - p0) * inv, t1 = (bmax - p0) * inv;
    vec3 tn = min(t0, t1), tf = max(t0, t1);
    float a = max(max(tn.x, tn.y), max(tn.z, 0.0)), b = min(min(tf.x, tf.y), min(tf.z, 1.0));
    return a <= b;
}
layout(std430, set = 1, binding = 0) buffer CharCounters { uint cc[]; };
layout(std430, set = 1, binding = 1) buffer VisList      { uint visList[]; };
layout(std430, set = 1, binding = 2) buffer SegLocal     { uint segLocal[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    bool corpse = ccfg.x == 1u;
    vec3 pos; uint lx, ly;
    if (!corpse) {
        if (i >= simCounters[C_LIVE]) return;
        Agent a = agents[i];
        if ((a.info.x & 0xFFu) == ST_DEAD) return;
        pos = a.pos.xyz; lx = a.info.x & 0xFFFFFF00u; ly = a.info.y;
    } else {
        if (i >= min(simCounters[C_CORPSES], ccfg2.y)) return;
        Corpse c = corpses[i];
        if ((c.info.z & 1u) == 0u) return;
        pos = c.pos.xyz; lx = c.info.x; ly = c.info.y;
    }
    if ((ccfg.w & CF_CULL) != 0u) {
        // conservative sphere: covers reaching, climbing, flailing, lying bodies and individual segments
        vec3 ctr = pos + vec3(0.0, cparams.w, 0.0);
        for (int k = 0; k < 6; ++k) if (dot(planes[k].xyz, ctr) + planes[k].w < -cparams.z) return;
    }
    if ((ccfg.w & CF_OCCLUSION) != 0u) {
        // Conservative occlusion by static buildings: hidden only if ALL corners of the character's bounding box
        // are hidden by the SAME box. The region a convex box hides from a point is convex, so the whole
        // bounding box (and everything the character can do inside it) is hidden: no popping.
        vec3 bmin = pos + vec3(-1.1, -0.2, -1.1), bmax = pos + vec3(1.1, 2.4, 1.1);
        vec3 centre = 0.5 * (bmin + bmax);
        vec3 e = eye.xyz;
        for (uint k = 0u; k < ccfg2.z; ++k) {
            vec3 omin = occluders[k * 2u].xyz, omax = occluders[k * 2u + 1u].xyz;
            if (!segmentHitsBox(e, centre, omin, omax)) continue;
            bool all = true;
            for (int c = 0; c < 8 && all; ++c) {
                vec3 p = vec3((c & 1) != 0 ? bmax.x : bmin.x, (c & 2) != 0 ? bmax.y : bmin.y, (c & 4) != 0 ? bmax.z : bmin.z);
                all = segmentHitsBox(e, p, omin, omax);
            }
            if (all) { atomicAdd(cc[CC_OCCLUDED], 1u); return; }
        }
    }
    uint vis = atomicAdd(cc[CC_VISIBLE], 1u);
    if (vis >= ccfg.y) { atomicAdd(cc[CC_OVERFLOW], 1u); return; }
    visList[vis] = corpse ? (i | REF_CORPSE) : i;
    atomicAdd(cc[corpse ? CC_VIS_CORPSES : CC_VIS_AGENTS], 1u);
    uint tris = 0u, segs = 0u, invoc = 0u;
    for (uint s = 0u; s < 10u; ++s) {
        uvec4 mi = meshInfo[meshIdFor(lx, ly, s)];
        if (mi.y == 0u) { segLocal[vis * 10u + s] = SEG_SKIP; continue; }   // missing forearm
        uint local = atomicAdd(cc[CC_CLASS_COUNT + mi.z], 1u);
        segLocal[vis * 10u + s] = (mi.z << 24) | local;
        tris += mi.y / 3u; segs += 1u; invoc += mi.w;
    }
    atomicAdd(cc[CC_TRIANGLES], tris);
    atomicAdd(cc[CC_SEGMENTS], segs);
    atomicAdd(cc[CC_VS_INVOC], invoc);
}
