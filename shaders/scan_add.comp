#version 450
#extension GL_GOOGLE_include_directive : require
// Pass 3: add scanned block offsets.
#include "common.glsl"
layout(local_size_x = 256) in;
layout(std430, set = 0, binding = 0) readonly buffer BlockSums { uint blockSums[]; };
layout(std430, set = 1, binding = 0) buffer CellStart { uint cellStart[]; };
void main() {
    uint gi = gl_GlobalInvocationID.x;
    if (gi <= grid.z) cellStart[gi] += blockSums[gl_WorkGroupID.x];
}
